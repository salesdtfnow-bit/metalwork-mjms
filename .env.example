# ─────────────────────────────────────────────────────────────────────────────
# MJMS environment configuration. Copy to .env.local (local) or set in Vercel
# Project → Settings → Environment Variables. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL (used in emails, QR codes on travellers, reset links)
APP_BASE_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Leave unset locally to use embedded PGlite at ./.data/pglite (no install needed).
# Production (Neon via Vercel Marketplace injects these automatically):
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require          # pooled
# DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require # direct (migrations, backups)
# DB_POOL_MAX=10
# PGLITE_DIR=./.data/pglite

# ── File storage ────────────────────────────────────────────────────────────
# Local: ./storage (outside the web root). Production: private Vercel Blob store.
# MJMS_STORAGE=local|blob          # auto: blob when a Blob store is connected
# STORAGE_DIR=./storage
# BLOB_READ_WRITE_TOKEN=...        # injected by Vercel when the Blob store is connected
# MAX_UPLOAD_MB=50                 # server uploads on Vercel are limited to ~4.5 MB per request

# ── Sessions ────────────────────────────────────────────────────────────────
# SESSION_IDLE_HOURS=12
# SESSION_ABSOLUTE_HOURS=168

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Without these, emails are written to the server log (console provider) and the outbox.
# EMAIL_PROVIDER=resend|console
# RESEND_API_KEY=re_...
# EMAIL_FROM="Workshop Name <mjms@your-verified-domain.co.uk>"
# RESEND_WEBHOOK_SECRET=whsec_...  # inbound email webhook (POST /api/webhooks/resend)

# ── BoxHero ─────────────────────────────────────────────────────────────────
# Mode: simulated (default, no real stock changes) | api | manual
# BOXHERO_MODE=simulated
# BOXHERO_API_TOKEN=...            # BoxHero → Settings → Integrations → API token (team must be in Location mode)
# BOXHERO_API_BASE=https://rest.boxhero-app.com/v1
# BOXHERO_TIMEOUT_MS=15000
# BOXHERO_WEBHOOK_SECRET=...       # ≥24 random chars; webhook URL = /api/webhooks/boxhero/<secret>

# ── Scheduled tasks ─────────────────────────────────────────────────────────
# CRON_SECRET=...                  # ≥16 random chars; Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"

# ── Demo ────────────────────────────────────────────────────────────────────
# DEMO_MODE=true                   # shows the demonstration banner
# DEMO_PASSWORD=...                # password given to all demo accounts by `npm run db:seed:demo`
# NEXT_PUBLIC_COMPANY_TZ=Europe/London
